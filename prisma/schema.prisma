generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Run {
  id        String   @id @default(uuid())
  domain    String
  topic     String
  keywords  String
  brief     String
  createdAt DateTime @default(now())
}

model Page {
  id        String   @id @default(uuid())
  url       String   @unique
  title     String?
  headings  String?
  createdAt DateTime @default(now())
}
